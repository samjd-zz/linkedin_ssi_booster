# https://buffer.com/developers/api
BUFFER_API_KEY=your_buffer_api_key_here
# https://www.bluesky.com/docs/api/atproto/overview
# BLUESKY_HANDLE=your_bluesky_handle_here
# https://atproto.com/app-passwords — create an app password with 'Post and read posts' permissions
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---------------------------------------------------------------------------
# PostgreSQL Database Configuration
# Used for persistent storage of persona graph, domain knowledge, extracted
# facts, selection learning, and truth trajectories.
# ---------------------------------------------------------------------------
DATABASE_ENABLED=true
POSTGRES_USER=ssi_booster
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=linkedin_ssi_booster
DATABASE_URL=postgresql://ssi_booster:change_this_to_a_secure_password@postgres:5432/linkedin_ssi_booster

# Content curator — how many entries to scan per RSS feed before filtering
# Higher = more variety; lower = faster. Default: 3
# CURATOR_MAX_PER_FEED=3

# RSS feeds to scan (JSON array — overrides built-in defaults entirely)
# CURATOR_RSS_FEEDS=[{"name":"Anthropic Blog","url":"https://www.anthropic.com/rss.xml"},{"name":"My Blog","url":"https://myblog.com/feed.xml"}]

# Niche keywords for filtering articles (comma-separated — overrides built-in defaults)
# CURATOR_KEYWORDS=RAG,retrieval augmented,LLM,large language model,language model,vector search,hybrid search,semantic search,information retrieval,embeddings,BM25,kNN,sentence transformer,context engineering,elasticsearch,Solr,Lucene,neo4j,knowledge graph,graph database,graph traversal,vector database,agent,multi-agent,MCP,model context protocol,FastMCP,agentic,agentic AI,tool calling,function calling,government AI,GovTech,regulatory AI,compliance AI,public sector AI,Spring AI,Spring Boot,Spring Batch,Java 21,virtual thread,Java AI,JMS,message queue,Solace,PubSub+,event broker,reinforcement learning,Gymnasium,Stable-Baselines,reward function,scikit-learn,feature engineering,NLP,neural network,Ollama,Groq,OpenRouter,Perplexity AI,Vaadin,Supabase,ElevenLabs,text to speech,generative media,FastAPI,AI-TDD,agentic harness,spec driven development

# ---------------------------------------------------------------------------
# SSI post focus — how often each pillar gets a post (should add up to 100).
# Bump a pillar up when it's lagging; dial it back when it improves.
# ---------------------------------------------------------------------------
# SSI_FOCUS_ESTABLISH_BRAND=25
# SSI_FOCUS_FIND_RIGHT_PEOPLE=27
# SSI_FOCUS_ENGAGE_WITH_INSIGHTS=24
# SSI_FOCUS_BUILD_RELATIONSHIPS=24

# ---------------------------------------------------------------------------
# Scheduler settings (optional)
# Controls how --generate --schedule selects publish weekdays/times.
#
# Timezone used for local slot calculation before conversion to UTC for Buffer.
# Use IANA timezone names (e.g. America/Toronto, America/New_York, Europe/London).
# SCHEDULER_TIMEZONE=America/Toronto
#
# Posting slots used each scheduled week.
# Format: day@HH:MM,day@HH:MM
# - day: monday..sunday
# - time: 24-hour HH:MM
# - order matters (slot 1 gets the first selected post, slot 2 gets the second, etc.)
# - number of slots = max posts scheduled per week per channel
#
# Example (default behavior):
# SCHEDULER_POSTING_SLOTS=tuesday@16:00,wednesday@16:00,friday@16:00
#
# Example (4-post cadence):
# SCHEDULER_POSTING_SLOTS=monday@09:30,tuesday@16:00,thursday@11:00,friday@16:00

# ---------------------------------------------------------------------------
# Docker Compose — Ollama URL override
# When running via docker compose, OLLAMA_BASE_URL is automatically set to
# http://ollama:11434 by the compose file. The value below is used for local
# (non-Docker) development. Do not change this line for Docker usage.
# ---------------------------------------------------------------------------

# Local Ollama — requires Ollama running at OLLAMA_BASE_URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model selection:
#   - gemma4:e4b    (fast, concise, good for short posts and tight VRAM — MoE, 3.8B active params, native system role, thinking mode)
#   - gemma4:26b    (best quality, recommended for high-end GPUs)
#   - qwen3.5:9b    (strong all-rounder, good for balanced quality/speed ~6GB VRAM)
#   - llama3.2      (3b, fastest, lower quality)
#   - phi3:mini     (3.8b, very fast, concise)
OLLAMA_MODEL=gemma4:e4b

# Fallback model — used automatically for ALL generation calls when the primary model
# returns an empty response or raises an error (retries once, then gives up).
OLLAMA_MODEL_FALLBACK=qwen3.5:9b

# Context window sent to Ollama per request.
# Higher values reduce prompt truncation for grounded prompts but use more RAM/VRAM.
# Typical values: 4096, 8192, 16384 (recommended), 32768
OLLAMA_NUM_CTX=16384

# ---------------------------------------------------------------------------
# GitHub repo context (optional)
# When set, public repo metadata is fetched, formatted, and appended to
# the persona graph so the LLM knows your real projects.
# Results are cached for 24 hours in github_repos_cache.json.
# ---------------------------------------------------------------------------

# GITHUB_USER=your_github_username

# Optional — raises unauthenticated rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_your_personal_access_token

# Comma-separated list of repo names to include.
# If omitted, all non-fork public repos are included.
# GITHUB_REPO_FILTER=repo-name-1,repo-name-2,repo-name-3

# Include compact README summaries in GitHub context block (default: true)
# GITHUB_INCLUDE_README_SUMMARIES=true

# Max number of repos to include in prompt context (default: 5)
# GITHUB_REPO_MAX_COUNT=5

# Max chars per README summary snippet (default: 600)
# GITHUB_README_MAX_CHARS=600

# Max chars allocated to GitHub-derived context (default: 15000)
# GITHUB_CONTEXT_MAX_CHARS=15000

# Truth grounding tech keywords (comma-separated)
#
# What this controls:
# - The grounding layer scans user prompts/topics/articles for these terms.
# - It also scans persona graph project facts for these terms to build fact tags.
# - Matching terms increase retrieval score for relevant facts.
#
# Where this is used:
# - --console: deterministic factual answers (project/company/year/details).
# - --generate: selects allowed personal facts for topic-based post writing.
# - --curate: selects allowed personal facts for article-based commentary.
#
# Practical effect:
# - Better matches -> stronger, more relevant grounded facts.
# - Missing keywords -> fewer relevant facts retrieved -> model may avoid personal claims.
#
# Tuning tips:
# - Use lowercase terms.
# - Include both broad and specific terms (e.g. java, spring, spring ai, rag).
# - Include abbreviations your profile uses (e.g. jms, mcp, knn).
# - Keep the list focused; noisy terms reduce ranking quality.
#
# Recommended default approach:
# - Keep one grounding set.
# - For curation coverage, expand CURATOR_KEYWORDS and CONSOLE_GROUNDING_TAG_EXPANSIONS first.
#
# If unset, built-in defaults are used.
# CONSOLE_GROUNDING_TECH_KEYWORDS=java,spring,spring ai,jms,python,fastapi,scikit-learn,gymnasium,stable-baselines3,elasticsearch,solr,lucene,neo4j,rag,llm,embeddings,vector search,hybrid search,bm25,knn,mcp,fastmcp,oracle,weblogic,vaadin,govtech,regulatory ai,public sector ai,sentence transformers,reinforcement learning

# Truth gate BM25 threshold (optional, float)
#
# What this controls:
# - Minimum BM25 similarity score required for a sentence to be considered
#   well-supported by the article text and persona facts.
# - Sentences with BM25 scores below this threshold are flagged as weakly
#   supported and may be removed by the truth gate.
#
# How it works:
# - Each sentence is tokenized and scored against a BM25 corpus built from
#   the article text and persona facts.
# - Higher thresholds = stricter validation (more sentences flagged).
# - Lower thresholds = more permissive (fewer sentences flagged).
#
# Recommended values:
# - 0.5: Permissive (allows paraphrased claims with weak evidence)
# - 1.0: Balanced (default - good for most use cases)
# - 2.0: Strict (requires strong evidence overlap)
# - 5.0: Very strict (requires very strong evidence match)
#
# When to adjust:
# - If the truth gate is too aggressive (removes valid claims), lower this value.
# - If the truth gate is too lenient (allows unsupported claims), raise this value.
# - This works alongside the existing token-matching checks for numeric claims,
#   years, dollar amounts, and company names.
#
# If unset, defaults to 1.0 (balanced).
# TRUTH_GATE_BM25_THRESHOLD=1.0

# Minimum spaCy cosine similarity between a sentence and the source article
# text for sentences that contain numeric claims, years, dollar amounts, or
# org names (Part C of the truth gate).  Sentences below this floor are
# flagged as low_semantic_similarity.  Only runs when article_text is
# non-empty (curation mode).
# If unset, defaults to 0.10.
# TRUTH_GATE_SPACY_SIM_FLOOR=0.10

# Minimum spaCy cosine similarity between a sentence and the best-matching
# persona/domain fact (Part E of the truth gate).  Runs in ALL contexts
# including console mode because persona facts are always present.  A value
# of 0.0 (vectors unavailable) is never flagged.  Raise to 0.10–0.20 for
# stricter enforcement.
# If unset, defaults to 0.05.
# TRUTH_GATE_FACT_SIM_FLOOR=0.05

# ---------------------------------------------------------------------------
# Identity & persona grounding — stored in data/avatar/persona_graph.json
# ---------------------------------------------------------------------------
# PROFILE_CONTEXT has been replaced by the persona graph. Edit the JSON at:
#   data/avatar/persona_graph.json
# to update your projects, skills, companies, and claims.
# The app loads this at startup — no env var required.

# ---------------------------------------------------------------------------
# Avatar Intelligence controls (optional)
# Feature flags and tuning for the learning, confidence, and memory systems.
# ---------------------------------------------------------------------------

# Enable/disable avatar learning entirely (default: true).
# When false: narrative memory is not injected into prompts and moderation
# events are not written to the learning log.
# AVATAR_LEARNING_ENABLED=true

# Confidence policy for the --curate publish path (default: balanced).
#
# What the confidence score is:
#   A publish-safety score (0.0–1.0) computed after the truth gate runs.
#   It starts at 1.0 and deductions are subtracted for problems found:
#
#     Signal                        Max deduction
#     -------------------------------------------------------------
#     Truth gate reason severity    -0.35  (how bad the removed sentences were)
#     Unsupported claim pressure    -0.30  (numeric/org/year failures in truth gate)
#     Truth gate removed count      -0.15  (raw count of removed sentences / 10)
#     Channel length pressure       -0.10  (post too long or too short for channel)
#     Narrative repetition          -0.10  (how much this echoes recent memory)
#     Grounding coverage ratio      +0.10  (bonus: well-grounded facts raise the score)
#
#   Level thresholds:  high >= 0.70  |  medium >= 0.40  |  low < 0.40
#
#   Score 1.00 = zero penalties fired (truth gate removed nothing, no unsupported
#   claims, good post length, no repeated narrative, good grounding coverage).
#   This is entirely separate from the DoT gradient — the DoT measures evidence
#   quality; the confidence score measures publish safety.
#
# Policy controls what happens with each level:
#   strict       — only high-confidence posts are scheduled as posts;
#                  medium → Ideas board; low → blocked entirely
#   balanced     — high and medium posts are scheduled; low → Ideas board
#   draft-first  — all posts go to Ideas board regardless of confidence
#
# Can also be overridden per-run with --confidence-policy strict|balanced|draft-first
# AVATAR_CONFIDENCE_POLICY=balanced

# Maximum number of items retained in narrative memory (default: 200).
# Older items are trimmed when the limit is reached (FIFO).
# AVATAR_MAX_MEMORY_ITEMS=200

# ---------------------------------------------------------------------------
# AI Persona & SSI Instructions (required for personalised output)
# Without PERSONA_SYSTEM_PROMPT the app falls back to a generic ghostwriter
# template with no knowledge of your name, projects, or domain rules.
# Fill in the bracketed placeholders below and uncomment to activate.
# Multi-line values must stay within the surrounding double-quotes.
# ---------------------------------------------------------------------------

# PERSONA_SYSTEM_PROMPT="You are a LinkedIn ghostwriter for [Your Full Name] — [Your Title], [Your Location].
# All persona truths, projects, and claims are loaded from data/avatar/persona_graph.json. Do NOT include any hardcoded facts here.
# Voice: [How you want to sound — e.g. technical but human, concise, direct, occasionally contrarian]
# Forbidden phrases: 'In the age of AI', 'Game changer', 'Exciting to share', 'Thrilled to announce', 'Delighted to', 'I am pleased to', 'landscape', 'leverage', 'unlock', 'revolutionize'.
# Format rules: Never start with 'I'. No bullet points in the post body — write in short punchy paragraphs. No hollow openers or conclusions. No corporate jargon or passive voice.
# Technical glossary — these definitions are exact and authoritative. Never redefine, expand, or paraphrase them differently:
# RAG = Retrieval-Augmented Generation (a technique that grounds LLM responses with retrieved documents)
# BM25 = Best Match 25 (probabilistic term-frequency ranking algorithm used in Elasticsearch/Lucene)
# kNN = k-Nearest Neighbors (vector similarity search)
# NLP = Natural Language Processing
# MCP = Model Context Protocol (Anthropic open standard for tool-calling agents)
# [TERM] = [Definition] — add any domain-specific abbreviations your audience uses
# Hard rule: Never spell out or expand a technical abbreviation unless it appears in the glossary above. If an abbreviation is not in the glossary, leave it as-is rather than guessing.
# IMPORTANT: Output plain text only — no Markdown. Do not use **, ##, __, `, or any other Markdown syntax. LinkedIn does not render Markdown."

# ------------------------------------------------------------------------------
# The "NLP —" sections below refer to Neuro-Linguistic Programming — a framework
# for influence and communication. Each pillar uses a specific NLP technique to
# make posts more persuasive and psychologically resonant with the target reader:
#   - Authority anchoring    (Establish Brand)
#   - Identity pacing        (Find Right People)
#   - Pattern interrupt      (Engage with Insights)
#   - Sensory storytelling   (Build Relationships)
# These are baked into the prompt so the AI applies them automatically.
#
# "There's no such thing as hypnosis... and this is it."
#   — Steven Heller, Monsters and Magical Sticks 
# (notes: https://richardstep.com/downloads/tools/Notes--Monsters-and-Magic-Sticks.pdf)
# ------------------------------------------------------------------------------

# SSI_ESTABLISH_BRAND="This post should ESTABLISH PROFESSIONAL BRAND.
# Your brand pillars — draw on these specifically when relevant:
# - [Pillar 1]: [specific project or achievement with a real number or outcome]
# - [Pillar 2]: [specific project or achievement with a real number or outcome]
# - [Pillar 3]: [specific skill or tool area with depth — e.g. 'X years with Elasticsearch']
# Writing rules:
# - Reference a real project, a specific number, a concrete architectural decision, or a hard lesson
# - Show depth — not 'I used RAG' but what index design you chose and why it mattered
# - End with a clear POV: what you'd do differently, what surprised you, what you stand behind
# - Write something practitioners will screenshot and save
# NLP — Authority anchoring:
# - Use certainty language and present-tense declarations ('The bottleneck is always X', 'This is what breaks at scale') — never hedge with 'I think' or 'maybe'
# - Presuppose the reader already understands the domain; write at their level, then pull them one step further
# - Embed the reader into the scenario: 'When you're designing at this scale, you discover...' — makes the expertise feel transferable, not boastful
# - Anchor credibility to specific outcomes and decisions, not titles or years of experience"

# SSI_FIND_RIGHT_PEOPLE="This post should help FIND THE RIGHT PEOPLE.
# - Mention specific tools, communities, or events relevant to your niche
# - Ask a question that invites replies from your target audience
# - Tag relevant communities or technologies (not people)
# - This drives profile visits from the right professionals
# NLP — Identity pacing and selective inclusion:
# - Open by mirroring the worldview of your exact target reader (pacing) — write an opener that assumes the reader already works in this space and already understands the problem. The opener must be specific to what THIS post is actually about. Example pattern: 'If you're building [topic of this post] at scale, you already know that [specific challenge in that domain]...' — the bracket content must match the article topic.
# - Use identity-based framing: 'The engineers who care about this are the ones who...' — causes the right audience to self-select in and the wrong audience to scroll past
# - Lead from their current reality to a new perspective they didn't have before (pacing → leading)
# - The closing question should be so specific to your niche that only the right engineers would have a meaningful answer to it"

# SSI_ENGAGE_WITH_INSIGHTS="This post should ENGAGE WITH INSIGHTS.
# - Reference or summarize a recent AI paper, article, or trend
# - Give YOUR take on it — don't just summarize
# - Make a bold or counterintuitive claim based on your experience
# - Invite discussion: 'What's your experience with this?'
# - This component rewards thoughtful engagement on others' content too
# NLP — Pattern interrupt and cognitive reframe:
# - Open with a pattern interrupt: a claim that directly contradicts the conventional wisdom on this topic — force the reader to stop scrolling
# - Use contrast structure to anchor the reframe: 'Everyone ships X. The teams that actually scale do Y.' — the contrast creates the insight
# - Reframe the finding in terms of what it means practically for someone building real systems, not what it means theoretically
# - End with a specific question that implies the reader has relevant experience — not 'what do you think?' but 'have you hit this wall when doing X?' — creates productive dissonance that demands a reply"

# SSI_BUILD_RELATIONSHIPS="This post should BUILD RELATIONSHIPS.
# - Share a behind-the-scenes story or honest lesson from a project
# - Be specific about challenges you faced and how you solved them
# - Show personality — not just technical facts
# - Make it feel like a conversation, not a press release
# - End with something that invites comments and connection
# NLP — Rapport through sensory storytelling and vulnerability:
# - Drop the reader into the middle of the moment — skip all preamble and open with a specific scene: 'It was the third deploy attempt. The index was corrupt.' — sensory detail creates presence
# - Use 'we' where natural; it signals collaboration and humanity rather than lone-genius posturing
# - Include a moment of genuine uncertainty, failure, or surprise before the resolution — vulnerability is what creates trust, not polish
# - The closing question should invite the reader to share their own parallel experience, not just react to yours — 'Has your team hit this?' beats 'Thoughts?'"

# ---------------------------------------------------------------------------
# YouTube Short spoken script persona (lipsync.video avatar)
# Used when --channel youtube is selected
# ---------------------------------------------------------------------------
# YOUTUBE_SHORT_SYSTEM_PROMPT="IMPORTANT — this is a YouTube Short spoken script for [Your Avatar Name]:
# - [Avatar name] is your digital avatar. Write entirely in the avatar's voice, first-person.
# - Begin with this exact intro: [Your avatar's opening line]
# - Target: 100-150 words maximum (60-second Short) — do NOT exceed 150 words
# - Spoken word only — natural contractions, conversational cadence, no jargon walls
# - No hashtags, no markdown, no bullet points, no stage directions
# - Structure: hook (1-2 sentences) → insight or story (3-4 sentences) → subscribe CTA
# - Close with exactly: [Your subscribe CTA]
# - Every sentence must be speakable aloud naturally
# NLP — Engage through conversational storytelling:
# - Use vivid sensory language and relatable scenarios to make technical points tangible.
# - Occasionally address the viewer directly and use conversational tag questions for rapport.
# - Anchor key takeaways with memorable phrases or metaphors."

# Truth gate whitelisted phrases (optional, comma-separated, case-insensitive, stripped)
# Sentences matching any of these phrases will always be kept by the truth gate.
# Example: TRUTH_GATE_WHITELISTED_PHRASES=what's up — sam here,hello world,thanks for watching
# TRUTH_GATE_WHITELISTED_PHRASES="what's up — sam here,If you're an AI engineer or Java dev who wants signal over noise — subscribe."

# ---------------------------------------------------------------------------
# Evidence retrieval split (project/domain)
# Controls how many project (persona) and domain knowledge facts are retrieved for grounding.
# Default: 3 project, 2 domain
# Controls how many project (persona) and domain knowledge facts are retrieved for grounding.
# Default: 3 project, 2 domain
EVIDENCE_PROJECT_COUNT=3
EVIDENCE_DOMAIN_COUNT=2

# Extracted knowledge (continual learning) — controls how extracted facts flow into generation.
# EXTRACTED_EVIDENCE_COUNT: max extracted facts passed to the HybridRetriever evidence pool
#   and DoT evidence paths per article. Raise to give learned facts more influence on grounding.
# EXTRACTED_CONTEXT_LIMIT: max extracted facts injected as text into the Ollama prompt.
#   Only facts whose tokens overlap with the current article are included (relevance filter).
# TOPIC_SIGNAL_WINDOW: number of most-recent extracted facts used to build the adaptive topic
#   signal that tilts SSI component selection toward recently covered themes.
EXTRACTED_EVIDENCE_COUNT=2
EXTRACTED_CONTEXT_LIMIT=10
TOPIC_SIGNAL_WINDOW=50

# SPACY_MODEL: spaCy pipeline to load for semantic similarity, NER, and summarization.
#   en_core_web_md (default) — includes 685k word vectors; eliminates the W007 similarity warning.
#   en_core_web_lg           — larger vectors, slightly more accurate but ~500MB download.
#   en_core_web_sm           — no word vectors; similarity falls back to context tensors (fast, less accurate).
#   Install the desired model first: python -m spacy download en_core_web_md
SPACY_MODEL=en_core_web_md

# ---------------------------------------------------------------------------
# Model2Vec text classification (optional — requires: pip install model2vec)
# Fast, static embedding-based classification using minishlab/potion-base-8M.
# Automatically classifies RSS articles into topic categories and maps them
# to SSI components (establish_brand, find_right_people, engage_with_insights,
# build_relationships).  Degrades gracefully when model2vec is not installed.
# ---------------------------------------------------------------------------

# Enable/disable Model2Vec classification entirely (default: true).
# Set to false to disable without uninstalling the package.
# MODEL2VEC_ENABLED=true

# Hugging Face model to use for static embeddings (default: minishlab/potion-base-8M).
# The model is downloaded on first use (~30MB) and cached by Hugging Face.
# MODEL2VEC_MODEL_NAME=minishlab/potion-base-8M

# Minimum cosine-similarity score for a category to appear in results (0.0–1.0).
# 0.0 = return all categories ranked by score (default, recommended for exploration).
# 0.3 = only return categories where the text has at least 0.3 similarity.
# MODEL2VEC_CONFIDENCE_THRESHOLD=0.0

# Number of texts to embed in a single batch call (default: 50).
# Increase for throughput on large article sets; decrease if you hit memory limits.
# MODEL2VEC_BATCH_SIZE=50

# Enable article classification during --curate runs (default: false).
# When true, articles are batch-classified before selection and category metadata
# is attached to each article dict for use by SSI picking and selection learning.
# Equivalent to passing --classify on every curate invocation.
# CURATE_CLASSIFY=false

# ---------------------------------------------------------------------------
# Wyoming Piper TTS voice synthesis for console output (optional)
# Requires: pip install sounddevice
# Requires: Wyoming Piper Docker container (included in docker-compose.yml)
# ---------------------------------------------------------------------------

# Enable voice output in console mode (default: false).
# When true, console responses will be spoken aloud using Wyoming Piper TTS.
# CONSOLE_USE_VOICE=false

# Wyoming Piper server connection (default: localhost:10200).
# Use 'localhost' for local development, or 'piper' when running in Docker.
# WYOMING_PIPER_HOST=localhost
# WYOMING_PIPER_PORT=10200

# Voice model to use (default: en_US-libritts_r-medium).
# Must match the --voice parameter in docker-compose.yml piper service.
# See https://github.com/rhasspy/piper/blob/master/VOICES.md for available models.
# CONSOLE_VOICE_MODEL=en_US-libritts_r-medium

# Speaker ID for multi-speaker models (optional, e.g., 896 for libritts_r).
# The en_US-libritts_r-medium model supports multiple speakers (0-903).
# Leave empty or omit for single-speaker models.
# https://rhasspy.github.io/piper-samples/#en_US-libritts_r-medium
# CONSOLE_VOICE_SPEAKER=896

# ---------------------------------------------------------------------------
# PulseAudio passthrough (Docker only)
# These are set automatically by run.sh using `id -u`. You do not need to
# set them manually unless you are running docker compose directly.
# ---------------------------------------------------------------------------
# HOST_UID=1000
# PULSE_RUNTIME_DIR=/run/user/1000/pulse

# --- IMAGE GEN CONFIG --- 
# Get this from your Civitai account settings (required for the flux-init download)
# https://civitai.com/user/account -> API Keys -> Create new key
# CIVITAI_API_KEY=your_civitai_key_here

# Path to the FLUX GGUF model inside the container.
# Matches the ./models/flux bind mount in docker-compose.yml.
# FLUX_MODEL_PATH=/app/models/flux/flux1-schnell-Q4_K_S.gguf

# Directory where generated images are saved inside the container.
# Bind-mounted to ./yt-vid-data on the host.
# IMAGE_OUTPUT_DIR=/app/yt-vid-data
