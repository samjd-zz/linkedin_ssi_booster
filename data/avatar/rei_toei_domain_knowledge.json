  "tidal_cycles_syntax": {
    "basic_functions": {
      "sound": {
        "syntax": "s \"synth_name\"",
        "description": "Select a synth or sample",
        "examples": [
          "s \"bd\"",
          "s \"industrial:3\"",
          "s \"sawtooth\""
        ]
      },
      "note": {
        "syntax": "note \"pitch_sequence\"",
        "description": "Define melodic patterns",
        "examples": [
          "note \"c3 e3 g3 c4\"",
          "note \"0 3 7 12\"",
          "note (sequence 48 50 52 55)"
        ]
      },
      "stack": {
        "syntax": "stack [pattern1, pattern2, ...]",
        "description": "Play multiple patterns simultaneously",
        "example": "stack(note(\"c3\"), note(\"e3\"), note(\"g3\"))"
      },
      "fast": {
        "syntax": ".fast(n)",
        "description": "Speed up pattern by factor of n",
        "example": "note(\"c d e f\").fast(2)"
      },
      "slow": {
        "syntax": ".slow(n)",
        "description": "Slow down pattern by factor of n",
        "example": "note(\"c d e f\").slow(2)"
      },
      "every": {
        "syntax": ".every(n, function)",
        "description": "Apply function every n cycles",
        "example": "note(\"c d e f\").every(4, x => x.rev())"
      }
    },
    "pattern_transformations": {
      "rev": {
        "description": "Reverse pattern",
        "example": "note(\"c d e f\").rev()"
      },
      "iter": {
        "description": "Rotate pattern each cycle",
        "example": "note(\"c d e f\").iter(4)"
      },
      "chunk": {
        "description": "Divide and transform pattern sections",
        "example": "note(\"c d e f\").chunk(2, x => x.fast(2))"
      },
      "jux": {
        "description": "Create stereo effect by applying function to one channel",
        "example": "note(\"c d e f\").jux(x => x.rev())"
      }
    },
    "effects": {
      "gain": {
        "syntax": ".gain(value)",
        "range": "0.0 - 2.0",
        "description": "Volume control"
      },
      "lpf": {
        "syntax": ".lpf(frequency)",
        "range": "20 - 20000 Hz",
        "description": "Low-pass filter cutoff"
      },
      "hpf": {
        "syntax": ".hpf(frequency)",
        "range": "20 - 20000 Hz",
        "description": "High-pass filter cutoff"
      },
      "delay": {
        "syntax": ".delay(amount)",
        "range": "0.0 - 1.0",
        "description": "Delay mix amount"
      },
      "delaytime": {
        "syntax": ".delaytime(time)",
        "description": "Delay time in seconds or beats"
      },
      "room": {
        "syntax": ".room(size)",
        "range": "0.0 - 1.0",
        "description": "Reverb room size"
      },
      "cutoff": {
        "syntax": ".cutoff(frequency)",
        "description": "Filter cutoff frequency"
      },
      "resonance": {
        "syntax": ".resonance(amount)",
        "range": "0.0 - 1.0",
        "description": "Filter resonance/Q"
      }
    },
    "advanced_patterns": {
      "euclidean": {
        "syntax": "euclid(hits, steps)",
        "description": "Euclidean rhythm generator",
        "example": "s(\"bd\").euclid(3, 8)"
      },
      "polyrhythm": {
        "syntax": "{pattern1, pattern2, pattern3}",
        "description": "Polyrhythmic patterns",
        "example": "note(\"{c d e, g a b c}\")"
      },
      "conditional": {
        "syntax": "pattern ? ifTrue : ifFalse",
        "description": "Conditional pattern selection"
      }
    },
