    "pattern_examples": {
      "basic_kick": "s(\"bd bd ~ bd ~ bd ~ bd\")",
      "industrial_hit": "s(\"industrial:3 ~ ~ ~ industrial:7 ~ ~ ~\").gain(0.8)",
      "bass_line": "note(\"c2 ~ ~ c2 ~ g1 ~ f1\").s(\"sawtooth\").lpf(400)",
      "hi_hat": "s(\"hh*8\").gain(\"0.6 0.8\").speed(1.2)",
      "nested_pattern": "stack(note(\"c3 e3 g3\").fast(2), note(\"c2\").slow(0.5))"
    }
  },
